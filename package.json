{
    "name": "websim.pollinations.ai",
    "private": true,
    "version": "0.0.0",
    "description": "Static BYOP app for generating shareable HTML pages with Pollinations.",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "deploy": "npm run build && polli sites deploy dist --name websim",
        "typecheck": "tsc --noEmit",
        "preview": "vite preview",
        "test": "node --test test/*.test.js",
        "test:live": "node scripts/test-live.mjs",
        "test:browser": "node scripts/test-browser.mjs"
    },
    "dependencies": {
        "@pollinations/sdk": "5.1.0-alpha.25",
        "@pollinations/ui": "0.1.0-alpha.25",
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.7.2",
        "vite": "^7.0.0",
        "@pollinations/cli": "0.1.71",
        "playwright": "1.62.1"
    }
}
